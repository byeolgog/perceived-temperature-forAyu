# 이 파일을 .env 로 복사한 뒤 발급받은 키를 넣으세요. (.env는 공유·업로드 금지)

# [기상청 예보] 둘 중 하나만 있으면 됩니다.
# 공공데이터포털 data.go.kr → '기상청_단기예보 조회서비스' 활용신청 → 일반 인증키(Decoding)
KMA_API_KEY=
# 또는 기상청 API허브 apihub.kma.go.kr → 단기예보 API 활용신청 → authKey
# 이 키로 홈 화면 '지금 캠퍼스 체감온도'(안양대 500m 격자 실측)도 받아요 (고해상도 격자자료 활용신청 필요)
KMA_APIHUB_KEY=

# [옷 쇼핑 연계] developers.naver.com → 애플리케이션 등록 → 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [선택] AI 한마디 문장 생성 (없으면 템플릿 문장 사용)
OPENAI_API_KEY=
